{
  "name": "alive-buddy",
  "version": "0.0.0",
  "description": "An autonomous agent based on ML decision trees and reAct loops.",
  "main": "dist/index.js",
  "bin": {
    "alive-buddy": "./bin/alive-buddy.js"
  },
  "scripts": {
    "start": "node dist/api/index.js",
    "dev": "tsx watch src/api/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "ML_SIDECAR_URL=http://127.0.0.1:1 tsx --test test/*.test.ts",
    "e2e": "tsx scripts/e2e-endra.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^10.0.1",
    "axios": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "chromadb": "^1.8.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "openai": "^4.47.1",
    "uuid": "^9.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.12",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}

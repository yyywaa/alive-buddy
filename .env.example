# 注意：OPENAI_* 仅被数据蒸馏脚本 (src/ml/distill.py) 读取；
# 运行时的 LLM 凭证由 CharacterConfig（SDK 或 /v1/session/init）传入，不走 .env
OPENAI_API_KEY="your-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o"

# ML Sidecar（Python FastAPI 决策树服务）
ML_SIDECAR_URL="http://127.0.0.1:8001"
CHROMA_URL="http://127.0.0.1:8000"

# 主动脉搏间隔（毫秒），可选，默认 60000
# PULSE_INTERVAL_MS="60000"
